{
  "name": "broke-glass",
  "version": "1.0.0",
  "private": true,
  "description": "Five post-glass mobile OS paradigms on one live core. Canvas 2D engines, zero shared layout.",
  "keywords": [
    "design-systems",
    "speculative-design",
    "experimental-ui",
    "creative-coding",
    "canvas",
    "react",
    "typescript",
    "mobile-ui"
  ],
  "homepage": "https://aiyufan3.github.io/broke-glass/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiyufan3/broke-glass.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test",
    "silhouettes": "node scripts/silhouettes.mjs",
    "posters": "node scripts/posters.mjs",
    "screens": "node scripts/screens.mjs",
    "og": "node scripts/posters.mjs && node scripts/og-preview.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/space-grotesk": "^5.2.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  }
}
